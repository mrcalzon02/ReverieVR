<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/stage_a_title"
            android:textColor="@color/accent"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp"
            android:text="@string/stage_a_description"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <LinearLayout
            style="@style/ReveriePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/ReverieSectionTitle"
                android:text="@string/device_section" />

            <TextView
                android:id="@+id/device_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/phone_battery_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/phone_battery_unknown"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <ProgressBar
                android:id="@+id/phone_battery_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="@color/progress_track"
                android:progressTint="@color/accent" />

            <TextView
                android:id="@+id/controller_battery_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/controller_battery_unknown"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <ProgressBar
                android:id="@+id/controller_battery_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="@color/progress_track"
                android:progressTint="@color/warning" />
        </LinearLayout>

        <LinearLayout
            style="@style/ReveriePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/ReverieSectionTitle"
                android:text="@string/controller_section" />

            <TextView
                android:id="@+id/controller_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/controller_status_unavailable"
                android:textColor="@color/warning"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/controller_status_explanation"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/bluetooth_settings_button"
                style="@style/ReverieSecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/open_bluetooth_settings" />
        </LinearLayout>

        <LinearLayout
            style="@style/ReveriePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/ReverieSectionTitle"
                android:text="@string/qol_section" />

            <Switch
                android:id="@+id/battery_hud_switch"
                style="@style/ReverieSwitch"
                android:text="@string/battery_hud_label" />

            <Switch
                android:id="@+id/look_up_reveal_switch"
                style="@style/ReverieSwitch"
                android:text="@string/look_up_reveal_label" />

            <Switch
                android:id="@+id/show_percentages_switch"
                style="@style/ReverieSwitch"
                android:text="@string/show_percentages_label" />

            <Switch
                android:id="@+id/retro_mode_switch"
                style="@style/ReverieSwitch"
                android:text="@string/retro_mode_label" />
        </LinearLayout>

        <LinearLayout
            style="@style/ReveriePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/ReverieSectionTitle"
                android:text="@string/vr_section" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vr_runtime_not_ready"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/enter_vr_button"
                style="@style/ReveriePrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/enter_vr" />
        </LinearLayout>

        <LinearLayout
            style="@style/ReveriePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/ReverieSectionTitle"
                android:text="@string/recovery_section" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/recovery_description"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/reset_settings_button"
                style="@style/ReverieDangerButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/reset_local_settings" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
