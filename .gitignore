.gradle/
.idea/
local.properties
*.iml
build/
app/build/
captures/
.externalNativeBuild/
.cxx/

# Pinned third-party source fetched locally for native DOS builds
third_party/dosbox-pure/src/

# Original third-party DOOM shareware archive fetched for packaging
third_party/doom-shareware/payload/default-content/doom19s.zip

# Diagnostic intake local tooling/state and secrets
diagnostic-intake/node_modules/
diagnostic-intake/.wrangler/
diagnostic-intake/.dev.vars
diagnostic-intake/.dev.vars.*
diagnostic-intake/.env
diagnostic-intake/.env.*


# Permanent ReverieVR signing material generated locally.
# Never commit the keystore, passwords, or GitHub-secret staging file.
.local/reverievr-signing/

# Local Valve source/imported derivatives and offline converter dependencies.
.local/steam-controller/
tools/steam_controller/node_modules/
tools/steam_controller/__pycache__/

# Never accidentally re-add restricted Valve CAD derivatives to the public
# source tree or auto-packaged Android assets. The app build also rejects it.
app/src/main/assets/steam_controller_2015/
.local/optional-licensed-assets/

# Official Suno paid-plan downloads and entitlement evidence remain private
# until explicitly reviewed/imported with scripts/import-suno-downloads.py.
.local/suno-downloads/
.local/suno-entitlements/
